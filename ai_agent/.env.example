# Copy to .env and fill in. Values already present in the environment take precedence.

# Anthropic API key (required unless the environment already provides credentials).
ANTHROPIC_API_KEY=

# Model and generation settings.
AGENT_MODEL=claude-opus-4-8
AGENT_MAX_TOKENS=16000
AGENT_MAX_ITERATIONS=10

# System prompt override (optional).
# AGENT_SYSTEM_PROMPT=You are a helpful assistant.

# Conversation memory: number of user turns to keep before trimming the oldest.
MEMORY_MAX_TURNS=20

# Retry behaviour for transient API failures.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

# Logging: DEBUG | INFO | WARNING | ERROR, and "json" or "text" output.
LOG_LEVEL=INFO
LOG_FORMAT=json
