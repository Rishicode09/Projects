# Copy to .env and adjust. Never commit .env.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (nested settings use the DATABASE__ prefix) ---
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=automarket
DATABASE__PASSWORD=automarket
DATABASE__NAME=automarket

# --- Redis ---
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECURITY__SECRET_KEY=dev-only-secret-change-me
SECURITY__ACCESS_TOKEN_EXPIRE_MINUTES=30
