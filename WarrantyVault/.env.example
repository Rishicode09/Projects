# Supabase — these are safe to expose to the client (anon key is RLS-protected)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Selects the OCR implementation: "mock" (default, offline) or "supabase" (Edge Function)
EXPO_PUBLIC_OCR_PROVIDER=mock

# --- Server-side only (Supabase Edge Function secrets, NEVER bundled into the app) ---
# Set with: supabase secrets set OPENAI_API_KEY=...
# OPENAI_API_KEY=sk-...
# SUPABASE_SERVICE_ROLE_KEY=...
