# Anchored to the repo root with a leading slash. An unanchored `data/`
# matches ANY directory of that name at any depth -- which silently excluded
# the entire src/pvdefect/data package from version control.
/data/
/artifacts/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
*.pt
*.pth
.DS_Store

# Ultralytics
yolo*.pt
runs/
/data/yolo/
*.jpg
!doc/**/*.jpg
